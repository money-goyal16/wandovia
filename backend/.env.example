# Copy this file to .env and fill in your own values. Never commit the real .env file.

# MongoDB connection string.
# Local:      mongodb://127.0.0.1:27017/trailmuse
# Atlas free tier: mongodb+srv://<user>:<password>@<cluster-url>/trailmuse
MONGODB_URI=mongodb://127.0.0.1:27017/trailmuse

# Port the Express server listens on
PORT=5000

# Gemini API key used by the AI itinerary generator (routes/ai.js)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Comma separated list of origins allowed to call this API (your frontend dev server)
CORS_ORIGIN=http://localhost:5173

# Secret used to sign JWT auth tokens. Use a long random string in production.
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

